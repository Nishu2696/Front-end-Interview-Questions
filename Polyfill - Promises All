1. Implement Promise.all polyfill

Promise.all(iterable)
-  Takes an iterable (usually an array) of promises or values.
-  Returns one new promise.
-  Resolves when all input items have resolved → with an array of their values in the same order.
-  Rejects immediately when any input item rejects → with that rejection reason.

function promiseAll(promises) {
  return new Promise((resolve, reject) => {
    const results = [];
    let resolvedCount = 0;

    promises.forEach((promise, index) => {
      // Wrap non-promises with Promise.resolve
      Promise.resolve(promise)
        .then(value => {
          results[index] = value;
          resolvedCount++;

          if (resolvedCount === promises.length) {
            resolve(results);
          }
        })
        .catch(reject); // If any promise fails, reject immediately
    });

    // Edge case: empty array
    if (promises.length === 0) {
      resolve([]);
    }
  });
}
